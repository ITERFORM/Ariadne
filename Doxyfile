# ============================================================================
#  Ariadne Agent Harness -- API reference (Doxygen 1.18.0, lean scope)
#
#  Generate:  ./docs/generate_docs.sh        (or `doxygen Doxyfile` at the root)
#  Output:    docs/api_reference/api/        <- the generated API reference
#             docs/api_reference/index.html  <- hand-written landing page, ABOVE
#                                             the API output; Doxygen never
#                                             writes into it (HTML_OUTPUT=api).
#  Reference: Doxyfile.default = stock 1.9.8 config kept for diffing.
#
#  Every tag below is accepted by the installed doxygen 1.18.0: this build
#  emits zero "unsupported tag" / "obsolete" warnings.
# ============================================================================

PROJECT_NAME           = "Ariadne Agent Harness"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "C++ agent harness: TUI, gateway, doctor, MCP tools, spec-bench and the maze memory backend."
OUTPUT_LANGUAGE        = English

# ------------------------------------------------------------------------ scope
# Only the C++ that IS the harness. tests/ (gtest), examples/, skills/, docs/,
# installer/, mk/ and build artefacts are not API surface.
INPUT                  = include src tools bench
RECURSIVE              = YES
EXCLUDE                = .git build tests examples logs skills docs installer mk
FILE_PATTERNS          = *.h *.hpp *.cc *.cxx *.cpp
EXCLUDE_SYMBOLS        = __impl __detail *Impl _impl _detail

# --------------------------------------------------------------- extraction
# The source carries no doc-comment blocks, so this reference is the symbol
# inventory: every class/member/file/template, private and static included.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_METHODS  = YES
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SHOW_USED_FILES        = YES
INLINE_SOURCES         = NO
FORCE_LOCAL_INCLUDES   = NO

# ------------------------------------------------- preprocessing: off (raw lex)
# No conditionally-compiled API surface needs resolving, so skipping the macro/
# include machinery costs the least and cannot fail on a missing include.
ENABLE_PREPROCESSING   = NO

# --------------------------------------------------------------------- warn
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

# ----------------------------------------------------------------- html only
GENERATE_HTML          = YES
OUTPUT_DIRECTORY       = docs/api_reference
HTML_OUTPUT            = api
HTML_FILE_EXTENSION    = .html

# Native dark base, then the site theme loaded after doxygen.css.
HTML_COLORSTYLE        = DARK
HTML_STYLESHEET        =
HTML_EXTRA_STYLESHEET  = docs/api_reference/assets/ariadne-docs.css
HTML_HEADER            =
HTML_FOOTER            =
HTML_EXTRA_FILES       =

# left tree navigation + generated index pages
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
SEPARATE_MEMBER_PAGES  = NO
ALIASES                =

# ------------------------------------------- in-page client search (no php)
# SEARCHENGINE=YES with SERVER_BASED_SEARCH=NO + EXTERNAL_SEARCH=NO ships
# doxygen's own in-browser engine (search/search.js + searchdata.js inside the
# output). Serves from a static file server or file:// -- no php, no server.
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO
SEARCH_INCLUDES        = YES
SEARCHDATA_FILE        = searchdata.js
EXTRA_SEARCH_MAPPINGS  =

# -------------------------------------------------- alphabetical index pages
ALPHABETICAL_INDEX     = YES
IGNORE_PREFIX          =

# -------------------------------------------------------------- aux lists off
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= NO
GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_CHI           = NO
GENERATE_QHP           = NO
GENERATE_ECLIPSEHELP   = NO
TOC_EXPAND             = NO


# --------------------------------------------------------------- no graphs
# v1 needs no external binary; the class hierarchy is generated from parsed
# inheritance independently of dot.
HAVE_DOT               = NO
DOT_CLEANUP            = NO

# --------------------------------------------------------------- other output
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_LATEX         = NO
# Anonymous namespaces are where the harness keeps its file-local state (e.g.
# src/dd_tui.cpp:490 `struct AgentTurns : dd::serve::TurnRunner` inside
# `namespace {`). With the default NO, doxygen still emits the link to that page
# but never writes it -- measured as 1 dead ref of 73,229 on 2026-11-19. YES
# documents them, which is what the file-Local Entities index needs.
EXTRACT_ANON_NSPACES   = YES
